# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json  # optional – many prefer to commit it, but if you use yarn, commit yarn.lock

# Environment variables (secrets)
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Build / temporary files
dist/
build/
*.tmp

# Binary executables (remove hey.exe and ignore)
hey.exe
*.exe

# Terraform / state (if any)
*.tfstate*
*.terraform*

# Docker volumes / data (optional)
data/
grafana/data/
prometheus/data/
tempo/data/
mimir/data/

# AI/Assistant files (if you don't want them in repo)
.clineignore
.clinerules/
.continue/
.continueignore